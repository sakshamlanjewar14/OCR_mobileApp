DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/ocr_leads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176
# Optional when tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional custom directory containing eng.traineddata, hin.traineddata and mar.traineddata:
# TESSDATA_PREFIX=E:\saksham\workspace\ocr_scanner_system\backend\ocr-runtime\tessdata
# Install eng, hin and mar Tesseract traineddata for full local multilingual OCR.
TESSERACT_LANGUAGES=eng+hin+mar
# Offline Hindi/Marathi to English: run scripts/setup_translation.py once.
# Use an absolute local path. No model downloads or external translation at scan time.
# TRANSLATION_MODEL_DIR=E:/saksham/workspace/ocr_scanner_system/backend/ocr-runtime/m2m100_418M
# Optional reverse geocoder. Leave blank to disable; only a user-triggered
# coordinate lookup is sent. Public Nominatim requires an identifying User-Agent.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# NOMINATIM_USER_AGENT=LeadGennie/1.0 (contact: operator@example.org)
